@page "{id:int}"
@model DetailsModel
@{
    var t = Model.Tarea;
    ViewData["Title"] = t.Titulo;
    var vencida = t.Estado != EstadoTarea.Hecha && t.FechaLimite < DateOnly.FromDateTime(DateTime.Today);
}

<div class="tm-card detalle-card estado-@t.Estado.Css()">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <span class="estado-badge"><i class="bi @t.Estado.Icono()"></i>@t.Estado.Texto()</span>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@t.Id">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            <a class="btn btn-outline-danger btn-sm" asp-page="Delete" asp-route-id="@t.Id">
                <i class="bi bi-trash3 me-1"></i>Eliminar
            </a>
        </div>
    </div>

    <h1 class="h3 fw-bold mb-3">@t.Titulo</h1>

    @if (string.IsNullOrWhiteSpace(t.Descripcion))
    {
        <p class="text-secondary fst-italic mb-0">Sin descripción</p>
    }
    else
    {
        <p class="descripcion-texto mb-0">@t.Descripcion</p>
    }

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-sm-6">
            <div class="dato-label mb-2">Responsable</div>
            <div class="d-flex align-items-center gap-2">
                <span class="avatar" style="--tono:@t.ResponsableNombre.Tono()">@t.ResponsableNombre.Iniciales()</span>
                <span class="fw-medium">@t.ResponsableNombre</span>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="dato-label mb-2">Fecha límite</div>
            <div class="fecha-chip @(vencida ? "vencida" : "") fs-6">
                <i class="bi @(vencida ? "bi-exclamation-circle-fill" : "bi-calendar-event")"></i>
                @t.FechaLimite.Corta()@(vencida ? " · Vencida" : "")
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a class="btn btn-link text-decoration-none" asp-page="Index">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>