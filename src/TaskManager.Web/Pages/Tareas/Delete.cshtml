@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Eliminar tarea";
}

<div class="tm-card form-card text-center">
    <div class="empty-state p-0 mb-3">
        <div class="icon danger mb-0"><i class="bi bi-trash3"></i></div>
    </div>

    <h1 class="h4 fw-bold">¿Eliminar esta tarea?</h1>
    <p class="text-secondary mb-4">
        Se eliminará <strong>@Model.Tarea.Titulo</strong>, asignada a @Model.Tarea.ResponsableNombre.
        Esta acción no se puede deshacer.
    </p>

    <form method="post" class="d-flex justify-content-center gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash3 me-1"></i>Sí, eliminar
        </button>
    </form>
</div>